# All Trading API — environment configuration example.
# Copy to `.env` (or export in your shell) and fill in YOUR OWN keys.
# Every API product has its own key; one key does not unlock other products.

# Default key used when no product-specific key resolves.
ATA_API_KEY=ap_yourkeyhere

# Per-product keys (uppercase product id, hyphens become underscores).
ATA_KEY_QUOTEX_ASSETS=ap_yourkeyhere
ATA_KEY_QUOTEX_QUOTES=ap_yourkeyhere
ATA_KEY_QUOTEX_REALTIME=ap_yourkeyhere
ATA_KEY_QUOTEX_SAVED=ap_yourkeyhere
ATA_KEY_QUOTEX_SCREENSHOTS=ap_yourkeyhere
ATA_KEY_QUOTEX_RESULTS=ap_yourkeyhere

# Update gate policy: strict | ask | warn | off  (default: strict)
ATA_UPDATE_POLICY=strict
# Seconds between update checks (default: 21600 = 6 hours)
ATA_UPDATE_TTL=21600
# Set to 1 to skip the update gate entirely (escape hatch)
ATA_SKIP_UPDATE=1
# Optional outbound proxy
ATA_HTTPS_PROXY=
